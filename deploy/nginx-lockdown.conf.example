server {
    listen 80;
    listen [::]:80;
    server_name lockdown.thbtz.in;
    # Use certbot or your existing certificate automation for HTTPS.
    location /.well-known/acme-challenge/ { root /var/www/html; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name lockdown.thbtz.in;

    # Set these paths to certificates issued for lockdown.thbtz.in.
    ssl_certificate     /etc/letsencrypt/live/lockdown.thbtz.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/lockdown.thbtz.in/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }
}
