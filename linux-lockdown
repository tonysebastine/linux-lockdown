#!/usr/bin/env bash
# Linux Lockdown unified CLI. Audit and planning only; remediation is intentionally disabled.
set -Eeuo pipefail
umask 077

VERSION="0.3.0"
ROOT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
AUDIT_ENGINE="$ROOT_DIR/linux-lockdown-audit.sh"

usage() {
  cat <<'USAGE'
Linux Lockdown — one entry point for safe server checks

Usage:
  bash linux-lockdown [command] [scope]

Commands:
  audit [scope]    Run the read-only audit (default command).
  plan [scope]     Show a cautious review plan, then the audit report.
  dry-run [scope]  Alias for plan; performs no system changes.
  verify           Check local script syntax, then run the full audit.
  apply            Refuse execution (remediation engine is not implemented).
  help             Show this help.

Scopes: all, ssh, firewall, web, system

Examples:
  bash linux-lockdown
  bash linux-lockdown audit ssh
  bash linux-lockdown plan all
  bash linux-lockdown dry-run firewall
  bash linux-lockdown verify

Safety:
  - audit/plan/dry-run/verify do not intentionally change system configuration.
  - No packages are installed and no services are restarted.
  - apply is disabled; this tool does not yet perform hardening changes.
  - Keep an active SSH session and out-of-band recovery available before future
    remediation features are considered.
USAGE
}

die() { printf 'ERROR: %s\n' "$*" >&2; exit 2; }
have() { command -v "$1" >/dev/null 2>&1; }

COMMAND="${1:-audit}"
if [[ $# -gt 0 ]]; then shift; fi
SCOPE="${1:-all}"
if [[ $# -gt 1 ]]; then die "Too many arguments. Run: bash linux-lockdown help"; fi

case "$COMMAND" in
  help|-h|--help)
    usage
    exit 0
    ;;
  apply)
    printf 'Linux Lockdown v%s: APPLY IS DISABLED.\n' "$VERSION" >&2
    printf 'No configuration was changed. The reviewed remediation engine, per-change backups, rollback, and post-change verification are not implemented yet.\n' >&2
    exit 3
    ;;
  audit|plan|dry-run)
    case "$SCOPE" in all|ssh|firewall|web|system) ;; *) die "Invalid scope '$SCOPE'. Valid scopes: all, ssh, firewall, web, system";; esac
    [[ -f "$AUDIT_ENGINE" ]] || die "Missing audit engine: $AUDIT_ENGINE"
    ;;
  verify)
    [[ $# -eq 0 ]] || die "verify takes no scope argument"
    ;;
  *)
    die "Unknown command '$COMMAND'. Run: bash linux-lockdown help"
    ;;
esac

printf 'Linux Lockdown v%s\nCommand: %s\n' "$VERSION" "$COMMAND"
printf 'Timestamp UTC: %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf unknown)"

if [[ "$COMMAND" == verify ]]; then
  printf '\n===== Local script syntax =====\n'
  bash -n "$ROOT_DIR/linux-lockdown" || die "Unified CLI syntax check failed"
  bash -n "$AUDIT_ENGINE" || die "Audit engine syntax check failed"
  printf ' - Unified CLI syntax: PASS\n - Audit engine syntax: PASS\n'
  SCOPE="all"
fi

if [[ "$COMMAND" == plan || "$COMMAND" == dry-run ]]; then
  cat <<'PLAN'

===== Proposed safe review plan (NO CHANGES) =====
1. Review effective SSH settings and confirm an alternate working login before considering SSH changes.
2. Review firewall policy against required SSH, web, panel, VPN, and application ports before considering rule changes.
3. Identify the hosting panel and application stack before changing web-server, runtime, or file permissions.
4. Check brute-force protection, update policy, backups, disk space, and service recovery procedures.
5. Approve each future remediation individually; never apply a blanket profile to an unknown stack.
6. Require a timestamped backup, syntax/config validation, post-change check, and documented rollback for each supported change.
PLAN
fi

printf '\n===== Read-only host audit =====\n'
case "$COMMAND" in
  audit|plan|dry-run|verify)
    bash "$AUDIT_ENGINE" "$SCOPE"
    ;;
esac

if [[ "$COMMAND" == plan || "$COMMAND" == dry-run ]]; then
  printf '\nPlan complete: no changes were made. The items above are review steps, not proof that each issue exists.\n'
fi
